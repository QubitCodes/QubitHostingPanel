{
	"name": "ghost-deploy",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=20.19.0"
	},
	"scripts": {
		"dev": "react-router dev",
		"build": "react-router build",
		"start": "node --env-file-if-exists=.env node_modules/@react-router/serve/bin.cjs build/server/index.js",
		"lint": "eslint . --max-warnings=0",
		"typecheck": "react-router typegen && tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"env:generate-secrets": "tsx scripts/generateEnvironmentSecrets.ts",
		"jobs:process": "node --env-file-if-exists=.env --import tsx scripts/processProvisioningJobs.ts",
		"usage:observe": "node --env-file-if-exists=.env --import tsx scripts/observeInfrastructureUsage.ts",
		"provider:bootstrap": "node --env-file-if-exists=.env --import tsx scripts/bootstrapProviderConnection.ts",
		"provider:reconcile": "node --env-file-if-exists=.env --import tsx scripts/reconcileProviderConnections.ts",
		"operations:readiness": "node --env-file-if-exists=.env --import tsx scripts/operationsReadinessReport.ts",
		"acceptance:frameworks:verify": "node --import tsx scripts/verifyFrameworkFixtures.ts",
		"acceptance:frameworks:prepare": "node --import tsx scripts/prepareFrameworkFixtures.ts",
		"acceptance:frameworks:smoke": "node --import tsx scripts/smokeFrameworkFixtures.ts",
		"acceptance:frameworks:source": "node --env-file-if-exists=.env --import tsx scripts/verifyFrameworkAcceptanceSource.ts",
		"acceptance:frameworks:live": "node --env-file-if-exists=.env --import tsx scripts/runLiveFrameworkAcceptanceBootstrap.ts",
		"staging:deploy:panel": "node --env-file-if-exists=.env --import tsx scripts/deployStagingPanel.ts",
		"staging:queue:proofs": "node --env-file-if-exists=.env --import tsx scripts/queueStagingDeploymentProofs.ts",
		"db:generate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs generate",
		"db:migrate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs migrate",
		"db:studio": "drizzle-kit studio",
		"db:verify": "node --env-file-if-exists=.env --import tsx scripts/verifyDatabase.ts",
		"db:verify:phase2": "node --env-file-if-exists=.env --import tsx scripts/verifyPhase2Deployment.ts",
		"db:verify:payments": "node --env-file-if-exists=.env --import tsx scripts/verifyPaymentProvisioningDeployment.ts",
		"db:verify:phase4": "node --env-file-if-exists=.env --import tsx scripts/verifyPhase4Deployment.ts",
		"db:verify:phase5": "node --env-file-if-exists=.env --import tsx scripts/verifyPhase5Deployment.ts",
		"db:seed": "node --env-file-if-exists=.env --import tsx src/db/seeders/index.ts",
		"db:seed:format": "node --env-file-if-exists=.env --import tsx src/db/seeders/db_format_seeder.ts",
		"db:seed:super-admin": "node --env-file-if-exists=.env --import tsx src/db/seeders/super_admin_seeder.ts",
		"db:seed:dummy": "node --env-file-if-exists=.env --import tsx src/db/seeders/dummy_data_seeder.ts",
		"db:backfill:customers": "node --env-file-if-exists=.env --import tsx src/db/seeders/customer_workspace_backfill.ts",
		"db:backfill:entitlements": "node --env-file-if-exists=.env --import tsx scripts/backfillSubscriptionEntitlements.ts",
		"applications:sync:policies": "node --env-file-if-exists=.env --import tsx scripts/syncApplicationPolicies.ts",
		"applications:audit:provider-references": "node --env-file-if-exists=.env --import tsx scripts/auditApplicationProviderReferences.ts",
		"platform:sync:schedules": "node --env-file-if-exists=.env --import tsx scripts/syncPlatformScheduledTasks.ts"
	},
	"dependencies": {
		"@hookform/resolvers": "^5.2.2",
		"@qubitcodes/msg91": "^0.2.0",
		"@qubitcodes/qcresp": "1.0.1",
		"@react-router/node": "8.3.0",
		"@react-router/serve": "8.3.0",
		"@tailwindcss/vite": "^4.2.1",
		"drizzle-orm": "^0.45.2",
		"drizzle-zod": "^0.8.3",
		"isbot": "^5.1.36",
		"jose": "^6.1.3",
		"libphonenumber-js": "^1.13.10",
		"lucide-react": "^0.577.0",
		"mysql2": "^3.23.2",
		"pg": "^8.20.0",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"react-hook-form": "^7.71.2",
		"react-router": "8.3.0",
		"simple-icons": "^16.28.0",
		"sonner": "^2.0.7",
		"tailwindcss": "^4.2.1",
		"tldts": "^7.4.10",
		"ua-parser-js": "1.0.41",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@react-router/dev": "8.3.0",
		"@types/node": "^24.10.13",
		"@types/pg": "^8.16.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@types/ua-parser-js": "^0.7.39",
		"drizzle-kit": "^0.31.10",
		"eslint": "^9.39.4",
		"eslint-plugin-react-hooks": "^7.0.1",
		"eslint-plugin-react-refresh": "^0.5.2",
		"globals": "^17.4.0",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.56.1",
		"vite": "^7.3.1",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^4.1.0"
	},
	"overrides": {
		"esbuild": "^0.28.1",
		"next": "16.2.12",
		"postcss": "^8.5.8",
		"sharp": "^0.35.3"
	}
}
