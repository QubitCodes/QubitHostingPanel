# Application
APP_URL=http://localhost:5173
APP_ENV=development
ENABLE_AUDIT_LOG=true
ENABLE_DEV_AUTH_BYPASS=false

# PostgreSQL / Supabase
DATABASE_URL=postgresql://postgres.uvwaszkwgaxuylquholt:[YOUR-PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:5432/postgres

# Encryption (base64-encoded 32-byte key; required before provider credentials are stored)
# Required for encrypted shared-cluster and workspace database credentials.
CREDENTIAL_ENCRYPTION_KEY=

# Shared database administration endpoint. Use management only for local staging access.
DATABASE_CLUSTER_CONNECTION_MODE=internal

# Encrypted per-database backup artifacts and native database client binaries.
DATABASE_BACKUP_STORAGE_PATH=storage/database-backups
DATABASE_BACKUP_COMMAND_TIMEOUT_SECONDS=3600
PG_DUMP_PATH=pg_dump
PG_RESTORE_PATH=pg_restore
MYSQL_DUMP_PATH=mysqldump
MYSQL_CLIENT_PATH=mysql

# Firebase server verification
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# MSG91 SDK
MSG91_AUTH_KEY=
MSG91_WHATSAPP_NUMBER=

# PayU Hosted Checkout (use the API key and 32-bit salt)
PAYU_ENABLED=false
PAYU_ENVIRONMENT=test
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=

# Razorpay Standard Checkout
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Hosting provider and Coolify starter workload
HOSTING_PROVIDER=mock
COOLIFY_ENABLED=false
COOLIFY_BASE_URL=
COOLIFY_API_TOKEN=
COOLIFY_SERVER_UUID=
COOLIFY_DESTINATION_UUID=
COOLIFY_DEFAULT_PROJECT_UUID=
COOLIFY_DEFAULT_ENVIRONMENT_NAME=production
COOLIFY_WILDCARD_DOMAIN=
GHOST_DEPLOY_REPOSITORY_URL=https://github.com/QubitCodes/GhostDeploy
COOLIFY_STARTER_IMAGE=nginx
COOLIFY_STARTER_IMAGE_TAG=alpine
COOLIFY_STARTER_PORT=80
CLOUDFLARE_DNS_API_TOKEN=
CLOUDFLARE_DNS_ACCOUNT_ID=
POWERDNS_API_URL=
POWERDNS_API_KEY=
POWERDNS_NAMESERVERS=ns1.ghostdeploy.com,ns2.ghostdeploy.com
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_STATE_SECRET=
COOLIFY_GITHUB_PRIVATE_KEY_UUID=
INTERNAL_JOB_SECRET=
COOLIFY_WEBHOOK_SECRET=

# Token signing (use long independent secrets)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
OTP_HASH_SECRET=
CHECKOUT_SIGNING_SECRET=
CHECKOUT_TAX_RATE_BPS=1800
CHECKOUT_QUOTE_TTL_MINUTES=10
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
