# Application
APP_URL=http://localhost:5173
APP_ENV=development
ENABLE_AUDIT_LOG=true

# PostgreSQL / Supabase
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qubit_hosting_panel

# Encryption (base64-encoded 32-byte key; required before provider credentials are stored)
CREDENTIAL_ENCRYPTION_KEY=

# Firebase server verification
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# MSG91 SDK
MSG91_AUTH_KEY=
MSG91_WHATSAPP_NUMBER=

# Token signing (use long independent secrets)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
