[Unit]
Description=Synchronize Ghost Deploy customer database gateways
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/lib/ghostdeploy/ghostdeploy-database-gateway-sync.py
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
